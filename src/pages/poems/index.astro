---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const poems = (await getCollection('poems', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Poems — Your Name">
  <section class="hero animate-in">
    <p class="hero__eyebrow">Writing</p>
    <div class="hero__body">
      <h1 class="hero__title">Poems</h1>
      <p class="hero__subtitle">A collection of verse.</p>
    </div>
  </section>

  {poems.length === 0 ? (
    <p style="color:var(--ink-soft); font-style:italic; padding-top:3rem">No poems yet. Add your first poem to <code>src/content/poems/</code>.</p>
  ) : (
    <ul class="post-list">
      {poems.map(poem => (
        <li class="post-list__item animate-in">
          <div>
            <p class="post-list__title">
              <a href={`${base}/poems/${poem.slug}`}>{poem.data.title}</a>
            </p>
            {poem.data.description && (
              <p class="post-list__desc">{poem.data.description}</p>
            )}
            {poem.data.tags && poem.data.tags.length > 0 && (
              <div class="tags" style="margin-top:0.5rem">
                {poem.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
          <span class="post-list__date">{formatDate(poem.data.date)}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

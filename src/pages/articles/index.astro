---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
}
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Articles — Mihika Sharma">
  <section class="hero animate-in">
    <p class="hero__eyebrow">Writing</p>
    <div class="hero__body">
      <h1 class="hero__title">Articles</h1>
      <p class="hero__subtitle">Essays and longer reflections.</p>
    </div>
  </section>

  {articles.length === 0 ? (
    <p style="color:var(--ink-soft); font-style:italic; padding-top:3rem">No articles yet. Add your first article to <code>src/content/articles/</code>.</p>
  ) : (
    <ul class="post-list">
      {articles.map(article => (
        <li class="post-list__item animate-in">
          <div>
            <p class="post-list__title">
              <a href={`${base}/articles/${article.slug}`}>{article.data.title}</a>
            </p>
            {article.data.description && (
              <p class="post-list__desc">{article.data.description}</p>
            )}
            {article.data.tags && article.data.tags.length > 0 && (
              <div class="tags" style="margin-top:0.5rem">
                {article.data.tags.map(tag => <span class="tag">{tag}</span>)}
              </div>
            )}
          </div>
          <span class="post-list__date">{formatDate(article.data.date)}</span>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

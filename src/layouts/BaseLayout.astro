---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'A literary blog of poems and essays.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
function isActive(segment: string) {
  return path.startsWith(`${base}/${segment}`) ? 'page' : undefined;
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
</head>
<body>
  <div class="container">
    <header class="site-header">
      <a href={base || '/'} class="site-title">Rainbow of Imagination</a>
      <nav class="site-nav">
        <a href={`${base}/poems`}    aria-current={isActive('poems')}>Poems</a>
        <a href={`${base}/articles`} aria-current={isActive('articles')}>Articles</a>
        <a href={`${base}/artworks`} aria-current={isActive('artworks')}>Artworks</a>
        <a href={`${base}/about`}    aria-current={isActive('about')}>About</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Mihika Sharma</span>
      <span>Built with Astro</span>
    </footer>
  </div>
</body>
</html>
